# MongoDB Atlas connection string. Never leaves the server.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=fatihsmg4

# Write-only token the car sends as `Authorization: Bearer ...` on the PUT endpoints.
# Generate with: openssl rand -hex 32
INGEST_TOKEN=

# Password for the web dashboard. Anyone who knows it can read the history.
DASHBOARD_PASSWORD=

# Signs the session cookie. Rotating it logs every browser out.
# Generate with: openssl rand -hex 32
SESSION_SECRET=
