<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="Widget.EV.NavTab" parent="Widget.Material3.Button.OutlinedButton">
    <item name="android:minWidth">0dp</item>
    <item name="android:minHeight">64dp</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="android:paddingStart">16dp</item>
    <item name="android:paddingEnd">12dp</item>
    <item name="android:gravity">start|center_vertical</item>
    <item name="android:maxLines">1</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:textSize">16sp</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textColor">@color/nav_tab_foreground</item>
    <item name="iconGravity">start</item>
    <item name="iconSize">24dp</item>
    <item name="iconPadding">12dp</item>
    <item name="iconTint">@color/nav_tab_foreground</item>
    <item name="backgroundTint">@color/nav_tab_background</item>
    <item name="strokeColor">@color/nav_tab_stroke</item>
    <item name="strokeWidth">1dp</item>
    <item name="cornerRadius">18dp</item>
    <item name="elevation">0dp</item>
  </style>
  <style name="Widget.EV.NavTab.Compact">
    <item name="android:paddingStart">2dp</item>
    <item name="android:paddingEnd">2dp</item>
    <item name="android:gravity">center</item>
    <item name="iconGravity">top</item>
    <item name="iconPadding">5dp</item>
  </style>
  <style name="Widget.EV.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
    <item name="boxBackgroundColor">@color/ev_background</item>
    <item name="boxStrokeColor">@color/input_stroke</item>
    <item name="boxStrokeWidth">1dp</item>
    <item name="boxStrokeWidthFocused">2dp</item>
    <item name="boxCornerRadiusTopStart">16dp</item>
    <item name="boxCornerRadiusTopEnd">16dp</item>
    <item name="boxCornerRadiusBottomStart">16dp</item>
    <item name="boxCornerRadiusBottomEnd">16dp</item>
    <item name="hintTextColor">@color/ev_accent</item>
    <item name="endIconTint">@color/ev_text_secondary</item>
    <item name="helperTextTextAppearance">@style/Text.EV.Secondary</item>
  </style>
  <style name="Text.EV.Eyebrow" parent="Text.EV.SectionHeader">
    <item name="android:textSize">16sp</item>
    <item name="android:textColor">@color/ev_accent</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:letterSpacing">0.12</item>
  </style>
  <style name="Text.EV.Hero" parent="Text.EV.Display">
    <item name="android:textSize">48sp</item>
    <item name="android:fontFamily">sans-serif-light</item>
    <item name="android:letterSpacing">-0.025</item>
    <item name="android:fontFeatureSettings">tnum</item>
  </style>
  <style name="Text.EV.Metric" parent="Text.EV.Display">
    <item name="android:textSize">34sp</item>
    <item name="android:fontFamily">sans-serif-light</item>
    <item name="android:fontFeatureSettings">tnum</item>
  </style>
  <style name="Text.EV.Metric.Compact">
    <item name="android:textSize">28sp</item>
  </style>
  <style name="DataRow" parent="">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:minHeight">48dp</item>
    <item name="android:paddingTop">10dp</item>
    <item name="android:paddingBottom">10dp</item>
    <item name="android:gravity">center_vertical</item>
  </style>
  <style name="DataLabel" parent="Text.EV.Secondary">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
  </style>
  <style name="DataValue" parent="Text.EV.Body">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:paddingStart">16dp</item>
    <item name="android:gravity">end</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:fontFeatureSettings">tnum</item>
    <item name="android:textColor">@color/ev_text_primary</item>
    <item name="android:text">—</item>
  </style>
</resources>
