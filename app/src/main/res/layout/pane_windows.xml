<?xml version="1.0" encoding="utf-8"?>
<!-- Windows page of the main pager. See pane_abrp.xml for how the pages are held.

     Its own page rather than a card on the Service one: this feature writes to the car and
     shares nothing with ABRP uploading — no token, no GPS, no interval. Sitting under
     "Upload Service" implied a dependency that does not exist. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardBackgroundColor="@color/ev_surface"
            app:cardCornerRadius="@dimen/ev_corner"
            app:strokeColor="@color/ev_outline"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/window_close_switch"
                    style="@style/Widget.EV.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/window_close_title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/window_close_hint"
                    android:textAppearance="@style/Text.EV.Secondary" />

                <TextView
                    android:id="@+id/window_close_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/window_close_stopped"
                    android:textAppearance="@style/Text.EV.Body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Event log. Its own card here, where there is room for more than the four lines
             it had to fit in beside the upload settings. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/ev_surface"
            app:cardCornerRadius="@dimen/ev_corner"
            app:strokeColor="@color/ev_outline"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/window_close_log_title"
                    android:textAppearance="@style/Text.EV.Body" />

                <TextView
                    android:id="@+id/window_close_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:fontFamily="monospace"
                    android:textAppearance="@style/Text.EV.Secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
