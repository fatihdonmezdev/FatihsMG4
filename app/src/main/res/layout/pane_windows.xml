<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_glass">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DONANIM VE GÜVENLİK DURUMU"
                android:textAppearance="@style/Text.EV.Eyebrow" />

            <TextView
                android:id="@+id/txt_win_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Bağlantı kontrol ediliyor…"
                android:textAppearance="@style/Text.EV.Body"
                android:textColor="@color/ev_text_primary" />

            <TextView
                android:id="@+id/txt_win_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Son komut: —"
                android:textAppearance="@style/Text.EV.Secondary" />
        </LinearLayout>

        <Space android:layout_width="1dp" android:layout_height="20dp" />

        <!-- Slider & Custom Duration Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_glass">

            <div android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
            </div>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TUŞA BASMA SÜRESİ (PULSE DURATION)"
                    android:textAppearance="@style/Text.EV.Eyebrow" />

                <TextView
                    android:id="@+id/txt_slider_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="350 ms"
                    android:textColor="@color/ev_accent"
                    android:textStyle="bold"
                    android:textSize="18sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_win_duration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:max="3000"
                android:progress="350" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aralık (havalandırma) için 250 - 450 ms arası idealdir. Tam açma/kapatma için 3500 - 5000 ms."
                android:textAppearance="@style/Text.EV.Secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pulse_down"
                    style="@style/Widget.EV.Button"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Seçilen Süre İNDİR" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pulse_up"
                    style="@style/Widget.EV.Button"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Seçilen Süre KALDIR" />
            </LinearLayout>
        </LinearLayout>

        <Space android:layout_width="1dp" android:layout_height="20dp" />

        <!-- Preset Actions Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_glass">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HAZIR HIZLI KOMUTLAR"
                android:textAppearance="@style/Text.EV.Eyebrow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_win_open_all"
                    style="@style/Widget.EV.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Tam Aç (5s)" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_win_close_all"
                    style="@style/Widget.EV.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:text="Tam Kapat (5s)" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_win_stop"
                    style="@style/Widget.EV.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="STOP (Durdur)" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
