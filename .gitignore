# mise : mise.toml est COMMITÉ (il décrit le build). Seules les surcharges
# locales, machine-spécifiques, sont ignorées.
mise.local.toml
.mise.local.toml

# Local API configuration and dependencies.
/server/.env
/server/node_modules

# Signed build output. Rebuilt from source by ./gradlew assembleUnstableDebug and
# signed locally — a checked-in APK is stale the moment anything above it changes.
*.apk
*.idsig

# Local MG4 platform-signing material. Keep the working copies inside this
# checkout for self-contained release builds, but never publish private keys.
/tools/platform.pk8
/tools/platform.x509.pem
/tools/platform.key
/tools/platform.p12

# Build dirs of the vendored EVHardware library.
/EVHardware/build
/EVHardware/.gradle
/EVHardware/**/build
